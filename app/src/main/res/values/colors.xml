<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============ Neon Garden ============ -->
    <color name="bg">#0A0F1A</color>
    <color name="surface">#111A2B</color>
    <color name="surface_raised">#16223A</color>
    <color name="surface_variant">#1E2A3F</color>

    <color name="neon_green">#00FFB2</color>
    <color name="neon_green_dim">#00C28A</color>
    <color name="electric_purple">#A855F7</color>
    <color name="amber">#FBBF24</color>
    <color name="raspberry">#FF3B6B</color>

    <color name="text_primary">#E2E8F0</color>
    <color name="text_secondary">#94A3B8</color>
    <color name="text_tertiary">#64748B</color>
    <color name="text_on_accent">#0A0F1A</color>

    <color name="divider">#1E2A3F</color>
    <color name="divider_strong">#2A3A55</color>

    <!-- ============ Семантические роли ============ -->
    <!-- Accent: только интерактив (кнопки, активные сегменты, фокус, "done") -->
    <color name="semantic_accent">@color/neon_green</color>

    <!-- Warning: "soon", "active" -->
    <color name="semantic_warning">@color/amber</color>

    <!-- Danger: "overdue", error -->
    <color name="semantic_danger">@color/raspberry</color>

    <!-- Info: origin, Private, important-приоритет -->
    <color name="semantic_info">@color/electric_purple</color>

    <!-- Neutral: normal/none срочность, normal/whatever приоритет, второстепенный текст -->
    <color name="semantic_neutral_strong">#FFFFFF</color>
    <color name="semantic_neutral">@color/text_tertiary</color>
    <color name="semantic_neutral_weak">@color/divider_strong</color>
    <color name="semantic_neutral_none">@color/divider</color>

    <!-- ============ Срочность (алиасы, для обратной совместимости) ============ -->
    <color name="urgency_overdue">@color/semantic_danger</color>
    <color name="urgency_soon">@color/semantic_warning</color>
    <color name="urgency_normal">@color/semantic_neutral</color>
    <color name="urgency_none">@color/semantic_neutral_weak</color>

    <!-- Старые имена -->
    <color name="colorPrimary">@color/bg</color>
    <color name="colorPrimaryDark">#05080F</color>
    <color name="colorAccent">@color/neon_green</color>
</resources>