<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TaskMGR" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/neon_green</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorPrimaryContainer">@color/neon_green</item>
        <item name="colorOnPrimaryContainer">@color/text_on_accent</item>
        <item name="colorSecondary">@color/electric_purple</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">@color/electric_purple</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="colorTertiary">@color/amber</item>
        <item name="colorOnTertiary">@color/text_on_accent</item>
        <item name="colorError">@color/raspberry</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>
        <item name="android:fontFamily">@font/onest</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TaskMGR.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.TaskMGR.Dialog</item>
        <item name="android:datePickerDialogTheme">@style/ThemeOverlay.TaskMGR.DatePicker</item>
        <item name="android:spinnerStyle">@style/TaskMGRSpinner</item>
        <item name="floatingActionButtonStyle">@style/Widget.TaskMGR.Fab</item>
    </style>

    <style name="ThemeOverlay.TaskMGR.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/surface_raised</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="colorPrimary">@color/neon_green</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorAccent">@color/neon_green</item>
        <item name="android:colorControlNormal">@color/divider_strong</item>
        <item name="android:colorControlActivated">@color/neon_green</item>
        <item name="android:colorControlHighlight">@color/neon_green_dim</item>
        <item name="colorControlNormal">@color/divider_strong</item>
        <item name="colorControlActivated">@color/neon_green</item>
        <item name="colorControlHighlight">@color/neon_green_dim</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TaskMGR.Dialog</item>
    </style>

    <style name="ThemeOverlay.TaskMGR.DatePicker" parent="ThemeOverlay.AppCompat.Dialog">
        <item name="colorAccent">@color/neon_green</item>
        <item name="colorPrimary">@color/neon_green</item>
        <item name="android:colorAccent">@color/neon_green</item>
        <item name="android:colorControlActivated">@color/neon_green</item>
        <item name="android:windowBackground">@color/surface_raised</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColor">@color/neon_green</item>
    </style>

    <style name="ShapeAppearance.TaskMGR.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>
</resources>