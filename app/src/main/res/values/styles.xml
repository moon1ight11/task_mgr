<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Toolbar -->
    <style name="Widget.TaskMGR.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/bg</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="navigationIconTint">@color/neon_green</item>
        <item name="android:elevation">0dp</item>
    </style>
    <!-- TabLayout (внутри экрана) -->
    <style name="Widget.TaskMGR.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="android:background">@color/bg</item>
        <item name="tabIndicatorColor">@color/neon_green</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabSelectedTextColor">@color/neon_green</item>
        <item name="tabTextColor">@color/text_secondary</item>
        <item name="tabRippleColor">@color/surface_variant</item>
    </style>
    <!-- FAB -->
    <style name="Widget.TaskMGR.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/neon_green</item>
        <item name="tint">@color/text_on_accent</item>
        <item name="android:elevation">8dp</item>
        <item name="elevation">8dp</item>
    </style>
    <!-- Card -->
    <style name="Widget.TaskMGR.Card" parent="Widget.Material3.CardView.Elevated">
    <item name="cardCornerRadius">@dimen/card_corner_radius</item>
    <item name="cardElevation">0dp</item>
    <item name="cardBackgroundColor">@color/surface</item>
    <item name="android:layout_marginBottom">10dp</item>
    <item name="strokeColor">@color/divider</item>
    <item name="strokeWidth">1dp</item>
</style>
    <style name="TaskMGRPlateIcon">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="TaskMGRToggleGroup" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@color/surface_raised</item>
        <item name="strokeColor">@color/divider_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="TaskMGRToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="TaskMGRSegButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:maxLines">1</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/neon_green_dim</item>
    </style>

    <!-- Swiss Typography: Заголовки (крупнее, жирнее) -->
    <style name="TaskMGRText.Title" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Swiss Typography: Основной текст (чистый, читаемый) -->
    <style name="TaskMGRText.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Swiss Typography: Лейблы (мелкие, разреженные заглавные) -->
    <style name="TaskMGRText.Label" parent="">
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- Применяем к твоим существующим стилям (пример, если они есть) -->
    <style name="TaskMGRPlateText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TaskMGRSegLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:layout_marginStart">4dp</item>
    </style>

    <style name="TaskMGRSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/dialog_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:spinnerItemStyle">@style/TaskMGRSpinnerItem</item>
        <item name="android:spinnerDropDownItemStyle">@style/TaskMGRSpinnerItem</item>
    </style>

    <style name="TaskMGRSpinnerItem" parent="Widget.AppCompat.TextView.SpinnerItem">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>