<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:padding="16dp">

  <!-- УТРО -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Утренняя сводка"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Задачи на сегодня"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
      android:id="@+id/switch_morning"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/row_morning"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="12dp">

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="Время"
      android:textColor="@color/text_secondary"
      android:textSize="13sp" />

    <TextView
      android:id="@+id/time_morning"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:padding="6dp"
      android:text="09:00"
      android:textColor="@color/neon_green"
      android:textSize="15sp"
      android:textStyle="bold" />
  </LinearLayout>

  <View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:background="@color/divider" />

  <!-- ВЕЧЕР -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="12dp">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Вечерняя сводка"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Задачи на завтра"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
      android:id="@+id/switch_evening"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/row_evening"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="Время"
      android:textColor="@color/text_secondary"
      android:textSize="13sp" />

    <TextView
      android:id="@+id/time_evening"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:padding="6dp"
      android:text="20:00"
      android:textColor="@color/neon_green"
      android:textSize="15sp"
      android:textStyle="bold" />
  </LinearLayout>

  <View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="12dp"
    android:background="@color/divider" />

  <TextView
    android:id="@+id/btn_check_updates"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:text="Проверить обновления"
    android:textColor="@color/neon_green"
    android:textSize="15sp"
    android:textStyle="bold"
    android:gravity="center" />
</LinearLayout>
