<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:fillViewport="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- ================= СЕКЦИЯ: СВОДКИ ================= -->
    <TextView
      style="@style/TaskMGRSegLabel"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginBottom="4dp"
      android:text="Сводки" />

    <!-- УТРО -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:paddingTop="4dp">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Утренняя сводка"
          android:textColor="@color/text_primary"
          android:textSize="15sp"
          android:textStyle="bold" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Задачи на сегодня и списания"
          android:textColor="@color/text_secondary"
          android:textSize="12sp" />
      </LinearLayout>

      <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_morning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/row_morning"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:paddingTop="2dp"
      android:paddingBottom="10dp">

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Время"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

      <TextView
        android:id="@+id/time_morning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:text="09:00"
        android:textColor="@color/neon_green"
        android:textSize="15sp"
        android:textStyle="bold" />
    </LinearLayout>

    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp"
      android:background="@color/divider" />

    <!-- ВЕЧЕР -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:paddingTop="12dp">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Вечерняя сводка"
          android:textColor="@color/text_primary"
          android:textSize="15sp"
          android:textStyle="bold" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Задачи на завтра"
          android:textColor="@color/text_secondary"
          android:textSize="12sp" />
      </LinearLayout>

      <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_evening"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/row_evening"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:paddingTop="2dp"
      android:paddingBottom="12dp">

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Время"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

      <TextView
        android:id="@+id/time_evening"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:text="20:00"
        android:textColor="@color/neon_green"
        android:textSize="15sp"
        android:textStyle="bold" />
    </LinearLayout>

    <!-- ================= СЕКЦИЯ: ПОДПИСКИ ================= -->
    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp"
      android:layout_marginTop="4dp"
      android:background="@color/divider_strong" />

    <TextView
      style="@style/TaskMGRSegLabel"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginTop="12dp"
      android:layout_marginBottom="4dp"
      android:text="Подписки" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:paddingTop="4dp">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Напоминания о списаниях"
          android:textColor="@color/text_primary"
          android:textSize="15sp"
          android:textStyle="bold" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Добавляются в утреннюю сводку"
          android:textColor="@color/text_secondary"
          android:textSize="12sp" />
      </LinearLayout>

      <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_subs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/row_subs_days"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:paddingTop="6dp"
      android:paddingBottom="12dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Предупреждать за"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btn_subs_1"
          style="@style/TaskMGRSegButton.Sort"
          android:layout_width="0dp"
          android:layout_height="34dp"
          android:layout_weight="1"
          android:text="1 день" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btn_subs_3"
          style="@style/TaskMGRSegButton.Sort"
          android:layout_width="0dp"
          android:layout_height="34dp"
          android:layout_weight="1"
          android:layout_marginStart="6dp"
          android:text="3 дня" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btn_subs_7"
          style="@style/TaskMGRSegButton.Sort"
          android:layout_width="0dp"
          android:layout_height="34dp"
          android:layout_weight="1"
          android:layout_marginStart="6dp"
          android:text="7 дней" />
      </LinearLayout>
    </LinearLayout>

    <!-- ================= О ПРИЛОЖЕНИИ ================= -->
    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp"
      android:layout_marginTop="4dp"
      android:background="@color/divider_strong" />

    <TextView
      android:id="@+id/btn_check_updates"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:padding="16dp"
      android:background="?attr/selectableItemBackground"
      android:text="Проверить обновления"
      android:textColor="@color/neon_green"
      android:textSize="14sp"
      android:textStyle="bold"
      android:gravity="center" />

  </LinearLayout>
</ScrollView>
