<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/bg"
  android:orientation="vertical">

  <androidx.appcompat.widget.Toolbar
    android:id="@+id/toolbar"
    style="@style/Widget.TaskMGR.Toolbar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    app:popupTheme="@style/ThemeOverlay.Material3.Dark">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_logo" />

      <TextView
        android:id="@+id/toolbar_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

      <ImageButton
        android:id="@+id/btn_plates_settings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Настройки плиток"
        android:scaleType="centerInside"
        android:src="@drawable/ic_plates_settings"
        android:tint="@color/neon_green" />

      <ImageButton
        android:id="@+id/btn_notification_settings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Настройки уведомлений"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_preferences"
        android:tint="@color/text_secondary" />
    </LinearLayout>
  </androidx.appcompat.widget.Toolbar>

  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/main_plates_recycler"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:nestedScrollingEnabled="false" />

  <TextView
    android:id="@+id/main_plates_empty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:padding="24dp"
    android:text="Все плитки скрыты. Откройте настройки, чтобы вернуть."
    android:textColor="@color/text_secondary"
    android:textSize="14sp"
    android:visibility="gone" />

  <com.google.android.material.tabs.TabLayout
    android:id="@+id/main_tabs"
    style="@style/Widget.TaskMGR.TabLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:tabMode="fixed" />

  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/tasks_recycler"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:clipToPadding="false"
    android:padding="12dp" />

  <TextView
    android:id="@+id/empty_view"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center"
    android:text="Пока пусто"
    android:textColor="@color/text_secondary"
    android:textSize="16sp"
    android:visibility="gone" />
</LinearLayout>
