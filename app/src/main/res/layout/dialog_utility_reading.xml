<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:padding="16dp">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Предыдущее показание"
    android:textColor="@color/text_secondary"
    android:textSize="12sp" />

  <EditText
    android:id="@+id/input_previous"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="0"
    android:inputType="numberDecimal" />

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Текущее показание"
    android:textColor="@color/text_secondary"
    android:textSize="12sp" />

  <EditText
    android:id="@+id/input_current"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="0"
    android:inputType="numberDecimal" />

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Тариф за единицу, ₽"
    android:textColor="@color/text_secondary"
    android:textSize="12sp" />

  <EditText
    android:id="@+id/input_rate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="0.00"
    android:inputType="numberDecimal" />

  <TextView
    android:id="@+id/tv_calc"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:textSize="15sp"
    android:textStyle="bold"
    android:textColor="@color/neon_green"
    android:text="Расход: 0 — Итого: 0.00 ₽" />

</LinearLayout>
