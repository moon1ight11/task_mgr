<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/input_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Название задачи"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/input_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Описание (опционально)"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="4"
            android:gravity="top|start"
            android:background="@null"
            android:padding="8dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Приоритет"
            android:layout_marginTop="8dp" />

        <!-- Приоритет: 3 кнопки -->
        <LinearLayout
            android:id="@+id/group_priority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_priority_important"
                style="@style/TaskMGRSegButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Важно" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_priority_normal"
                style="@style/TaskMGRSegButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Обычно" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_priority_whatever"
                style="@style/TaskMGRSegButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Потом" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Срок"
            android:layout_marginTop="8dp" />

        <!-- Тип дедлайна: 4 кнопки (для не-авто третья скрыта программно) -->
        <LinearLayout
            android:id="@+id/group_due_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_due_none"
                style="@style/TaskMGRSegButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Нет" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_due_exact"
                style="@style/TaskMGRSegButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Дата" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_due_range"
                style="@style/TaskMGRSegButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Период" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_due_km"
                style="@style/TaskMGRSegButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Км" />
        </LinearLayout>

        <EditText
            android:id="@+id/input_due_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Дата (ДД.ММ.ГГГГ)"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:visibility="gone" />

        <EditText
            android:id="@+id/input_due_from"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Период с (ДД.ММ.ГГГГ)"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:visibility="gone" />

        <EditText
            android:id="@+id/input_due_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Период по (ДД.ММ.ГГГГ)"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:visibility="gone" />

        <EditText
            android:id="@+id/input_due_km"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Пробег (км)"
            android:inputType="number"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Повтор"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/spinner_repeat_rule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/input_repeat_km"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Интервал, км"
            android:inputType="number"
            android:visibility="gone" />

        <EditText
            android:id="@+id/input_repeat_months"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Интервал, месяцев"
            android:inputType="number"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>