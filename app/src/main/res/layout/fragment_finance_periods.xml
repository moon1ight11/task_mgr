<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical">

  <!-- Селектор периода -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp">

    <ImageButton
      android:id="@+id/btn_prev_period"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:src="@android:drawable/ic_media_previous"
      android:tint="@color/neon_green"
      android:contentDescription="Предыдущий период" />

    <TextView
      android:id="@+id/tv_period_name"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center"
      android:text="—"
      android:textSize="15sp"
      android:textStyle="bold"
      android:textColor="@color/text_primary"
      android:maxLines="1"
      android:ellipsize="end" />

    <ImageButton
      android:id="@+id/btn_next_period"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:src="@android:drawable/ic_media_next"
      android:tint="@color/neon_green"
      android:contentDescription="Следующий период" />
  </LinearLayout>

  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="12dp">

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_fin_summary"
        style="@style/Widget.TaskMGR.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

          <TextView
            android:id="@+id/tv_fin_period_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:text="—" />

          <TextView
            android:id="@+id/tv_fin_income"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:text="Доход: 0 ₽" />

          <TextView
            android:id="@+id/tv_fin_spent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:text="Потрачено: 0 ₽" />

          <TextView
            android:id="@+id/tv_fin_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/neon_green"
            android:text="Остаток: 0 ₽" />

          <!-- ==== Блок оценки ==== -->

          <TextView
            android:id="@+id/tv_fin_score_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:text="Оценка: —" />

          <ProgressBar
            android:id="@+id/pb_fin_score"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/neon_green"
            android:progressBackgroundTint="@color/surface_variant" />

          <TextView
            android:id="@+id/tv_fin_score_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:text="—" />

          <TextView
            android:id="@+id/tv_fin_score_trend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary"
            android:visibility="gone" />

          <!-- ==== Кнопки действий ==== -->

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fin_add_expense"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Добавить трату" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fin_add_from_template"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Добавить из шаблона" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fin_add_subs"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="Добавить списания подписок" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fin_add_shopping"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="Импортировать покупки" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <TextView
        android:id="@+id/tv_fin_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="Период не выбран"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fin_expenses_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:nestedScrollingEnabled="false" />
    </LinearLayout>
  </ScrollView>
</LinearLayout>
