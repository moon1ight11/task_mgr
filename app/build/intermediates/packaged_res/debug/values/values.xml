<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="amber">#FBBF24</color>
    <color name="bg">#0A0F1A</color>
    <color name="colorAccent">@color/neon_green</color>
    <color name="colorPrimary">@color/bg</color>
    <color name="colorPrimaryDark">#05080F</color>
    <color name="divider">#1E2A3F</color>
    <color name="divider_strong">#2A3A55</color>
    <color name="electric_purple">#A855F7</color>
    <color name="neon_green">#00FFB2</color>
    <color name="neon_green_dim">#00C28A</color>
    <color name="raspberry">#FF3B6B</color>
    <color name="surface">#111A2B</color>
    <color name="surface_raised">#16223A</color>
    <color name="surface_variant">#1E2A3F</color>
    <color name="text_on_accent">#0A0F1A</color>
    <color name="text_primary">#E2E8F0</color>
    <color name="text_secondary">#94A3B8</color>
    <color name="text_tertiary">#64748B</color>
    <color name="urgency_none">@color/text_tertiary</color>
    <color name="urgency_normal">@color/neon_green</color>
    <color name="urgency_overdue">@color/raspberry</color>
    <color name="urgency_soon">@color/amber</color>
    <string name="app_name">TaskMGR</string>
    <string name="empty_reference">Справочник пуст</string>
    <string name="empty_shopping">Список покупок пуст</string>
    <string name="empty_tabs">Нет вкладок. Нажмите +</string>
    <string name="empty_tasks">Пока пусто</string>
    <style name="ShapeAppearance.TaskMGR.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>
    <style name="Theme.TaskMGR" parent="Theme.Material3.Dark.NoActionBar">
        
        <item name="colorPrimary">@color/neon_green</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorPrimaryContainer">@color/neon_green</item>
        <item name="colorOnPrimaryContainer">@color/text_on_accent</item>

        
        <item name="colorSecondary">@color/electric_purple</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">@color/electric_purple</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>

        
        <item name="colorTertiary">@color/amber</item>
        <item name="colorOnTertiary">@color/text_on_accent</item>

        
        <item name="colorError">@color/raspberry</item>
        <item name="colorOnError">#FFFFFF</item>

        
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>

        
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TaskMGR.Dialog</item>
        <item name="floatingActionButtonStyle">@style/Widget.TaskMGR.Fab</item>
    </style>
    <style name="ThemeOverlay.TaskMGR.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/neon_green</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TaskMGR.Dialog</item>
    </style>
    <style name="Widget.TaskMGR.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.TaskMGR.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/neon_green</item>
        <item name="tint">@color/text_on_accent</item>
        <item name="android:elevation">8dp</item>
        <item name="elevation">8dp</item>
    </style>
    <style name="Widget.TaskMGR.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="android:background">@color/bg</item>
        <item name="tabIndicatorColor">@color/neon_green</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabSelectedTextColor">@color/neon_green</item>
        <item name="tabTextColor">@color/text_secondary</item>
        <item name="tabRippleColor">@color/surface_variant</item>
    </style>
    <style name="Widget.TaskMGR.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/bg</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="navigationIconTint">@color/neon_green</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>